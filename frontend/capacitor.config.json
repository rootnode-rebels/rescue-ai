{
  "appId": "org.rescueai.app",
  "appName": "RescueAI",
  "webDir": "public",
  "server": {
    "url": "https://frontend-flame-two-34.vercel.app",
    "cleartext": true
  },
  "plugins": {
    "Geolocation": {
      "enableHighAccuracy": true,
      "timeout": 5000,
      "maximumAge": 0
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
